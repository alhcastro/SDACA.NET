<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reglas del ERP: seguridad, sesión, licencia, parámetros, bitácora y acceso a datos. Sin interfaz. -->
  <PropertyGroup>
    <TargetFramework>$(CoopeNetTfm)</TargetFramework>
    <RootNamespace>CoopeNet.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- 2.6.1 o superior: corrige GHSA-473q-m89c-ghf8 -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoopeNet.Core.Tests" />
  </ItemGroup>

</Project>
