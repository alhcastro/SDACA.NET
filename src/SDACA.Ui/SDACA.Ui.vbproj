<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controles comunes y el contrato IModulo que cada módulo implementa para aparecer en el menú. -->
  <PropertyGroup>
    <TargetFramework>$(SdacaNetWindows)</TargetFramework>
    <RootNamespace>SDACA.Ui</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Empty</MyType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDACA.Core\SDACA.Core.vbproj" />
    <EmbeddedResource Include="..\..\logo.jpg" LogicalName="SDACA.Ui.logo.jpg" />
  </ItemGroup>

</Project>
